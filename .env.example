# Backend (apps/api) — leave blank locally; never commit real secrets
APP_ENV=development
DATABASE_URL=sqlite:///./tradepulse.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LLM_API_KEY=
LLM_PROVIDER=bedrock
LLM_PROMPT_VERSION=invoice-extract-bedrock@1.0.0
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=2048
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GLEIF_MODE=fixture
GLEIF_BASE_URL=
VLEI_VERIFIER_MODE=fixture
SCREENING_SOURCE_MODE=fixture
OPENSANCTIONS_API_KEY=
# live = Yahoo futures (no key); static_demo = offline map only
PRICE_SOURCE_MODE=live

# Prefer AWS_PROFILE + `aws login` over static keys
AWS_PROFILE=tradepulse
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
DOCUMENT_STORAGE_BACKEND=memory
S3_DOCUMENTS_BUCKET=
S3_DOCUMENTS_PREFIX=tradepulse/docs/

# Frontend (apps/web) — use apps/web/.env.local for Next
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_DATA_MODE=api
