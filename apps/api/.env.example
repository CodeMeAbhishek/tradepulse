# Secrets — blank placeholders only; fill locally, never commit real values
APP_ENV=development
DATABASE_URL=sqlite:///./tradepulse.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GLEIF_MODE=live
GLEIF_BASE_URL=https://api.gleif.org/api/v1
VLEI_VERIFIER_MODE=fixture
SCREENING_SOURCE_MODE=fixture
# live = OpenSanctions (set OPENSANCTIONS_API_KEY); fixture = DEMO/MOCK list
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_BASE_URL=https://api.opensanctions.org
OPENSANCTIONS_DATASET=sanctions
OPENSANCTIONS_MATCH_THRESHOLD=0.85
# live = Yahoo Finance futures (copper/steel/rice/cotton/spices-proxy); static_demo = offline map
PRICE_SOURCE_MODE=live
# fixture = labeled-text heuristic; bedrock = Amazon Bedrock Converse (Nova Lite)
LLM_PROVIDER=bedrock
LLM_API_KEY=
LLM_PROMPT_VERSION=invoice-extract-bedrock@1.0.0
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=2048

AWS_PROFILE=tradepulse
AWS_REGION=ap-south-1
DOCUMENT_STORAGE_BACKEND=s3
S3_DOCUMENTS_BUCKET=tradepulse-docs-420653187168-ap-south-1
S3_DOCUMENTS_PREFIX=tradepulse/docs/
